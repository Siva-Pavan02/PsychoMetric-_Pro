generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ConfirmedVia {
  client_verify
  webhook
  reconcile
}

enum AssessmentStatus {
  CREATED
  PAYMENT_PENDING
  PAYMENT_FAILED
  QUESTIONS_UNLOCKED
  COMPLETED
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCESS
  FAILED
}

model Participant {
  id          String       @id @default(cuid())
  name        String
  email       String
  phone       String
  createdAt   DateTime     @default(now())
  assessments Assessment[]
  payments    Payment[]

  @@index([email])
}

model Assessment {
  id            String           @id @default(uuid())
  participantId String
  participant   Participant      @relation(fields: [participantId], references: [id])
  status        AssessmentStatus @default(CREATED)
  startedAt     DateTime         @default(now())
  completedAt   DateTime?
  responses     Response[]
  payment       Payment?
  result        Result?
  report        Report?

  @@index([participantId])
}

model Response {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])
  questionId   String
  answer       Int

  @@unique([assessmentId, questionId])
  @@index([assessmentId])
}

model Payment {
  id                String         @id @default(cuid())
  participantId     String
  participant       Participant    @relation(fields: [participantId], references: [id])
  assessmentId      String         @unique
  assessment        Assessment     @relation(fields: [assessmentId], references: [id])
  razorpayOrderId   String         @unique
  razorpayPaymentId String?        @unique
  amount            Int
  currency          String         @default("INR")
  status            PaymentStatus  @default(CREATED)
  confirmedVia      ConfirmedVia?
  paidAt            DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([razorpayOrderId])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  eventId     String    @unique  // x-razorpay-event-id header — idempotency key
  event       String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?
}

model Result {
  id                String     @id @default(cuid())
  assessmentId      String     @unique
  assessment        Assessment @relation(fields: [assessmentId], references: [id])
  openness          Float
  conscientiousness Float
  extraversion      Float
  agreeableness     Float
  neuroticism       Float
  createdAt         DateTime   @default(now())
}

model Report {
  id                   String     @id @default(cuid())
  assessmentId         String     @unique
  assessment           Assessment @relation(fields: [assessmentId], references: [id])
  content              Json
  accessTokenHash      String?    // SHA-256 of raw token
  accessTokenCreatedAt DateTime?
  expiresAt            DateTime?
  revokedAt            DateTime?
  emailSentAt          DateTime?  // set by Phase 4 email helper
  createdAt            DateTime   @default(now())
  pdf                  ReportPdf?
}

model ReportPdf {
  reportId    String   @id
  report      Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  bytes       Bytes
  contentHash String
  createdAt   DateTime @default(now())
}

model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

model EmailLog {
  id        String      @id @default(cuid())
  recipient String
  subject   String
  status    EmailStatus @default(PENDING)
  error     String?
  createdAt DateTime    @default(now())
  sentAt    DateTime?
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  details   Json?
  createdAt DateTime @default(now())
}
